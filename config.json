{
    "result_dir": "results",
    "teacher_model_name": "meta-llama/Llama-3.1-8B",
    "local_dataset": false,
    "quantization": true,
    "quantization_bit": 8,
    "teacher_quantization_4": {
        "enabled": true,
        "mode": "4bit",
