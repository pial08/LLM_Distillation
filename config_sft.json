{
  "result_dir": "saved_models/",
  "seed": 42,
  "use_fp16": true,

  "teacher_model_name": "meta-llama/Meta-Llama-3-8B",

  "max_samples": 20,
  "min_chars": 20,
  "input_max_length": 56,
  "output_max_new_tokens": 256,
  "teacher_batch_size": 2,

  "train_ratio": 0.8,
  "val_ratio": 0.1,

  "student_max_length": 512,
  "student_batch_size": 2,
  "learning_rate": 1e-6,
  "num_epochs": 8,
  "grad_accum_steps": 4,

  "per_device_train_batch_size": 2,
  "per_device_eval_batch_size": 2,
  "max_grad_norm": 1,

  "student_model": {
    "base_model_name": "saved_models/TestLLaMa-v1.0",
    "hidden_size": 512,
    "intermediate_size": 1024,
    "num_hidden_layers": 6,
    "num_attention_heads": 8,
    "num_key_value_heads": 8,
    "max_position_embeddings": 512
  }
}
